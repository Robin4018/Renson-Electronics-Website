# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch (screenshots, dev logs)
/scratch

.vercel

# Raw source footage and loose working-copy videos in the repo root.
# The site's own videos live in /public/videos and are tracked.
# (Renson_Electronics_hero_video.mp4 predates this rule and stays tracked.)
/Renson elec footages/
/*.mp4
